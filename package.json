{
  "name": "telon-tv",
  "private": true,
  "description": "Herramientas de desarrollo de Telón TV: pruebas, lint y empaquetado para Samsung (Tizen).",
  "scripts": {
    "lint": "eslint .",
    "test:unit": "node --test --test-timeout=20000 \"test/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=60000 \"test/e2e/**/*.test.js\"",
    "test:bdd": "cucumber-js",
    "test": "npm run lint && npm run test:unit && npm run test:bdd && npm run test:e2e",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='app/src/main/assets/www/js/**' \"test/unit/**/*.test.js\" test/e2e/flujo.test.js",
    "mutation": "stryker run",
    "build:tizen": "node scripts/build-tizen.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^24.1.3",
    "playwright-core": "^1.64.1"
  }
}
