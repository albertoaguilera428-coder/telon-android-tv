{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comentario": "Mutación solo en la lógica de mayor riesgo (reglas del dominio, protocolo de addons, red y foco del control remoto): es lenta y ahí es donde un error pasa desapercibido. Se corre a demanda o en el pipeline semanal, no en cada push.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/unit/addon-client.test.js test/unit/interfaz.test.js test/unit/concurrencia.test.js test/unit/state.test.js"
  },
  "mutate": [
    "app/src/main/assets/www/js/domain/*.js",
    "app/src/main/assets/www/js/infra/addon-client.js",
    "app/src/main/assets/www/js/infra/http.js",
    "app/src/main/assets/www/js/ui/tv-remote.js"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "htmlReporter": {
    "fileName": "build/mutacion/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "tempDirName": ".stryker-tmp"
}
